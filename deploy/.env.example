# cp .env.example .env 후 수정하세요.
# 이 파일은 /volume1/docker/torrent_web_scraper/.env 에 둡니다.

# git clone 받은 소스 경로
SOURCE_DIR=/volume1/dev/torrent_web_scraper

# Transmission / qBittorrent 비밀번호 (cron 실행 시 사용)
TRANSMISSION_PASSWORD=

# cron 표현식 (기본: 3시간마다)
CRON_SCHEDULE=0 */3 * * *

# config named volume
# - 기존 manager 설정 공유: torrentscraper_torrent_manager (확인: docker volume ls | grep torrent)
#   → 이 경우 기존 manager 스크랩/스케줄을 꺼 두세요. 중복 다운로드 위험.
# - 새로 시작: torrent_web_scraper_config (setup.sh 가 자동 생성)
CONFIG_VOLUME=torrent_web_scraper_config

# setting.json download 경로와 동일한 NAS 절대경로
VIDEO=/volume1/video
DOWNLOADS=/volume1/docker/transmission/downloads

TZ=Asia/Seoul
LC_ALL=C.UTF-8
