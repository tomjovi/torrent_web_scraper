# cp .env.example .env 후 수정하세요.

# Transmission / qBittorrent 비밀번호 (스케줄 실행 시 사용)
TRANSMISSION_PASSWORD=

# cron 표현식 (기본: 3시간마다)
CRON_SCHEDULE=0 */3 * * *

# 기존 torrentscraper 와 공유하는 config named volume 이름
# 확인: docker volume ls | grep torrent
CONFIG_VOLUME=torrentscraper_torrent_manager

# setting.json download 경로와 동일하게 NAS 절대경로 지정
VIDEO=/volume1/video
DOWNLOADS=/volume1/docker/transmission/downloads

TZ=Asia/Seoul
LC_ALL=C.UTF-8
